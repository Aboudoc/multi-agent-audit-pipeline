# Copy to .env (or just export these) before running for real.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. By default each agent uses its own model tier (see pipeline/agents.py:
#   reentrancy -> opus, access-control -> sonnet, integer-overflow -> haiku).
# Set AUDIT_MODEL to force ONE model for every agent instead:
#   claude-opus-4-7    (most capable)
#   claude-sonnet-4-6  (balanced)
#   claude-haiku-4-5   (fastest / cheapest)
# AUDIT_MODEL=claude-haiku-4-5
